<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>CustomInspectors</RootNamespace>
    <AssemblyName>CustomInspectors</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CopyToMods>false</CopyToMods>
    <SpecialItemsLibPath Condition="'$(SpecialItemsLibPath)' == ''">$(ResonitePath)rml_mods\SpecialItemsLib.dll</SpecialItemsLibPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ResoniteModLoader" Version="5.0.1" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Resonite.GameLibs" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SpecialItemsLib">
      <HintPath>$(SpecialItemsLibPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
